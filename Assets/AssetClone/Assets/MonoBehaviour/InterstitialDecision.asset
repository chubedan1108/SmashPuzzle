%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 1165467460, guid: fad461395bee5d752fa43a6380398b3a, type: 3}
  m_Name: InterstitialDecision
  m_EditorClassIdentifier:
  Source: "// =====================================================================================\n// InterstitialDecision.js — decides whether to show an interstitial after a level ends.\n// Host: AppLovinMaxService (C#) calls shouldShowInterstitial(ctx) at every level win/fail.\n//\n// DELIVERY MODEL — THE SCRIPT IS THE CONFIG UNIT\n//   • This file ships with the build (synced by JSImporter into\n//     Assets/Javascript/Ads/InterstitialDecision.asset, assigned on AppLovinMaxService).\n//   • To change values OR logic in production, publish a FULL replacement of this script\n//     as the Remote Config STRING key `interstitial_decision_js_v1`, wrapped in a JSON\n//     envelope: {\"body\": \"<the whole script, JSON-escaped>\"} (the Unity editor window\n//     Tools > Ads > Remote Script Packer strips comments + produces it). There are NO standalone\n//     interstitial_* remote keys — all thresholds are HARDCODED in the PROFILES block below\n//     (two level buckets: EARLY = levels 1-50, LATE = 51+, composed from one shared BASE)\n//     and travel with the script.\n//   • Failure chain: a broken REMOTE script automatically demotes to this BAKED copy; if\n//     no script is usable at all, interstitials fail CLOSED (none shown, never spammed).\n//     This baked file is therefore the real fallback — keep it correct and conservative.\n//\n// HOW PRODUCT CHANGES PACING (99% of edits)\n//   1. Copy this whole file.\n//   2. Edit the numbers in the >>> PROFILES <<< block near the bottom: BASE moves both\n//      buckets at once; a bucket's override literal moves just that one (EARLY = levels\n//      1-50, LATE = 51+).\n//   3. Pack it with Tools > Ads > Remote Script Packer (strips comments, validates, copies\n//      the {\"body\": ...} JSON) and publish under `interstitial_decision_js_v1`. No app update.\n//   Logic changes (new rules, A/B arms, pity timers...) are the same flow: edit\n//   shouldShowInterstitial (the entry point), keep decideInterstitial untouched.\n//\n// =====================================================================================\n// WHAT YOUR SCRIPT CAN ACCESS (designer reference)\n// =====================================================================================\n//\n// 1) ctx — the runtime state object passed to shouldShowInterstitial(ctx).\n//    All times are unix milliseconds; compare against ctx.nowMs or getUnixMs().\n//\n//    field                          | type      | meaning\n//    -------------------------------|-----------|---------------------------------------------\n//    ctx.level                      | number    | level just finished (1-based)\n//    ctx.difficulty                 | number    | 0=Normal, 1=Hard, 2=SuperHard\n//    ctx.won                        | bool      | level was completed\n//    ctx.failed                     | bool      | level was failed (won/failed never both true)\n//    ctx.placement                  | string    | \"level_completed\" | \"level_failed\"\n//    ctx.nowMs                      | number    | current unix ms\n//    ctx.sessionStartMs             | number    | app-session start, unix ms\n//    ctx.firstLaunchMs              | number    | FIRST app launch on this device, unix ms —\n//                                   |           |   persisted, so install-age rules work:\n//                                   |           |   var days = (ctx.nowMs - ctx.firstLaunchMs) / 86400000;\n//                                   |           |   CAVEAT: for players who installed before this\n//                                   |           |   field shipped, it's their first launch AFTER\n//                                   |           |   that update, not the true install time.\n//    ctx.adsRemoved                 | bool      | remove-ads owned (NOTE: C# short-circuits\n//                                   |           | before the script, so in practice always false here)\n//    ctx.platform                   | string    | \"android\" or \"ios\"\n//    ctx.buildNumber                | number    | app build number (0 if unavailable) — e.g. gate a\n//                                   |           | rule to builds that have a required feature:\n//                                   |           |   if (ctx.buildNumber < 120) { ...old behavior... }\n//    ctx.interstitial.ready         | bool      | an interstitial is cached and ready\n//    ctx.interstitial.count         | number    | interstitials SHOWN this session\n//    ctx.interstitial.timestampsMs  | [number]  | END time of each (when the player got the\n//                                   |           |   screen back) — the pacing anchors, so ad\n//                                   |           |   duration never eats the between-ads gap\n//    ctx.interstitial.stats         | [object]  | one per impression this session:\n//                                   |           |   { level, placement, network, timestampMs, revenue }\n//                                   |           |   timestampMs = display START; revenue = USD (0 until reported)\n//    ctx.rewarded.ready             | bool      | a rewarded ad is cached and ready\n//    ctx.rewarded.count             | number    | rewarded ads COMPLETED this session\n//    ctx.rewarded.lastShownMs       | number    | last rewarded END, unix ms (0 = none yet)\n//    ctx.rewarded.timestampsMs      | [number]  | rewarded END times, oldest -> newest\n//    ctx.iap.count                  | number    | LIFETIME completed purchase count (persisted)\n//    ctx.iap.purchases              | [object]  | one per purchase, oldest -> newest:\n//                                   |           |   { productId, title, price, currency,\n//                                   |           |     transactionId, timestampMs }\n//                                   |           |   price is in the purchase's own LOCAL currency\n//                                   |           |   (ISO code in `currency`) — never sum across\n//                                   |           |   currencies; use count / productId checks.\n//\n// 1b) ctx.ua — UA ATTRIBUTION (which marketing campaign/creative acquired this user).\n//     Source: the AppsFlyer conversion-data callback, persisted to disk by the client\n//     (AppsFlyerManager.PersistConversionDataForAds) — so values survive restarts and are\n//     available OFFLINE from the first launch after the data arrived. New callbacks update\n//     stored values; a key is only overwritten when the fresh payload carries a non-empty\n//     value (a degraded/organic re-callback can't wipe real attribution; status always\n//     refreshes). NO BAKED RULE reads ctx.ua — but the segmentUser(ctx) utility in [1]\n//     classifies the user from ctx.ua.campaign (AdUser/IAPUser/BlendedUser/DefaultUser)\n//     for variants to route on. DEFAULTS (before the first conversion\n//     callback ever fires — typically the user's very first session, or ATT-limited iOS):\n//     status = \"unknown\", every other field = \"\" (empty string).\n//\n//     field             | AppsFlyer key   | BigQuery counterparts                        | example\n//     ------------------|-----------------|----------------------------------------------|------------------------------\n//     ctx.ua.status     | af_status       | (drives dim.user_info.network=\"organic\")     | \"organic\" | \"non_organic\" |\n//                       |                 |                                              |   \"unknown\" (default)\n//     ctx.ua.network    | media_source    | dim.user_info.network,                       | \"applovin_int\", \"unityads_int\",\n//                       |                 |   appsflyer.conversions.media_source         |   \"Facebook Ads\"\n//     ctx.ua.campaign   | campaign        | dim.user_info.campaign,                      | \"rs_and_applovin_01072026_\n//                       |                 |   appsflyer.conversions.campaign             |    us_roas_d28_i-cpm_i-iaa\"\n//     ctx.ua.campaignId | campaign_id     | appsflyer.conversions.campaign_id            | \"799b45ee08bcbfa6ffd2...\"\n//     ctx.ua.adset      | af_adset        | dim.user_info.ad_set,                        | \"_DEFAULT\"\n//                       |                 |   appsflyer.conversions.adset_name           |\n//     ctx.ua.creative   | af_ad           | dim.user_info.creative,                      | \"rs3\"..\"rs7\"\n//                       |                 |   appsflyer.conversions.ad_name              |\n//     ctx.ua.creativeId | af_ad_id        | appsflyer.conversions.ad_id                  | \"176631469\"\n//     ctx.ua.channel    | af_channel      | dim.user_info.channel                        | \"graphic\", \"reward\"\n//     ctx.ua.siteId     | af_siteid       | dim.user_info.source_id                      | \"d2625cf3a4cc...\" (pub hash)\n//     ctx.ua.matchType  | match_type      | dim.user_info.match_type                     | \"id_matching\", \"srn\"\n//\n//     (Raw payloads land in BigQuery as `royal-smash.events.adjust_attribution`.af_conversion_data\n//      — legacy event name, AppsFlyer data. Its flat network/campaign/creative columns hold\n//      placeholder \"af\" strings; the JSON payload above is the real source. All string values.)\n//\n// 2) Built-in functions (Foundation JS engine — same environment as cb's dice script).\n//\n//    function            | meaning\n//    --------------------|------------------------------------------------------------\n//    log(msg)            | Unity console, tagged [JS] — decisions are logged automatically\n//    logerr(msg)         | Unity console error, tagged [JS]\n//    assert(cond, msg)   | throws when cond is false (a throw retires this script: a remote\n//                        |   copy demotes to the baked one; baked failing = no ads shown)\n//    getUnixMs()         | current unix ms (same clock as ctx timestamps)\n//    setNumber/setStr/   | PERSISTENT device storage for script state (streaks, flags...);\n//      setBool('js_x',v) |   keys MUST start with \"js_\"\n//    getNumber('key')    | read a Remote Config value — THROWS if missing. OPTIONAL: the\n//    getStr / getBool    |   standard model hardcodes values in the PROFILES block; only\n//    keyExists('key')    |   reach for these if a variant deliberately reads shared keys.\n//\n// 3) RETURN CONTRACT — shouldShowInterstitial must return:\n//      { show: bool, reason: string }\n//    reason feeds the ad_blocked analytics event when show=false (\"ok\" when true).\n//    SECONDARY (plain bools, both currently always true):\n//      rewardedAdsEnabled(ctx)     — should the UI offer rewarded ads (show/hide buttons).\n//      interstitialAdsEnabled(ctx) — does this user get interstitials AT ALL. false makes\n//        C# act like RemoveAds was purchased (AdsRemovedPermanently → shop hides offers),\n//        and shouldShowInterstitial short-circuits to BLOCK(disabled) through it.\n//    Every function the C# host calls is marked [ENTRY_POINT] at its definition — those\n//    names and signatures are the contract, never rename them.\n//\n//    DEDUPLICATE, DON'T COPY: when two entry points need the same rule (a segment check,\n//    an enable flag, a threshold), implement it ONCE in its own function and CALL it from\n//    both — exactly how shouldShowInterstitial calls interstitialAdsEnabled instead of\n//    repeating its logic. Copied logic silently drifts apart on the next edit and the two\n//    answers stop agreeing; a shared function makes that impossible within a script.\n//\n// 4) WHAT THE C# HOST DOES AROUND YOU (can't be overridden from JS):\n//    • remove-ads owners and the SR-debug admin kill-switch are decided in C# BEFORE the\n//      script — the engine doesn't even run for them.\n//    • ad readiness is RE-CHECKED in C# after a positive verdict — returning show=true\n//      without a cached ad never triggers a broken no-op show.\n//\n// =====================================================================================\n// FILE LAYOUT\n//   [1] utilities            — small helpers over ctx arrays + segmentUser (don't need editing)\n//   [2] decideInterstitial   — THE DECIDER: fixed, pure rule engine. Keep it untouched.\n//   [3] PROFILES (BASE + EARLY/LATE level buckets) + shouldShowInterstitial\n//       + rewardedAdsEnabled — PRODUCT EDITS HERE.\n// =====================================================================================\n\n\n// =====================================================================================\n// SCRIPT_CONTRACT — compatibility handshake with the C# host. The host refuses to use a\n// script whose contract doesn't EXACTLY match the generation it implements (it demotes to\n// the baked copy instead), so a script published under the wrong RC key, or written for a\n// newer build, can never run against a mismatched ctx.\n// Bump TOGETHER, only on an incompatible ctx/return-contract change:\n//   this value  <->  C# AppLovinMaxService.DecisionContractVersion  <->  the RC key suffix\n//   (interstitial_decision_js_v1 -> _v2), so old builds keep reading their own generation.\n// =====================================================================================\nvar SCRIPT_CONTRACT = 1;\n\n\n// ---------- [1] utilities ----------\n\nfunction lastOf(arr) {\n  return (arr && arr.length > 0) ? arr[arr.length - 1] : 0;\n}\n\nfunction countSince(timestampsMs, nowMs, windowSec) {\n  var cutoff = nowMs - windowSec * 1000;\n  var n = 0;\n  for (var i = 0; i < timestampsMs.length; i++) {\n    if (timestampsMs[i] >= cutoff) n++;\n  }\n  return n;\n}\n\nfunction secondsSince(nowMs, thenMs) {\n  return thenMs <= 0 ? Number.MAX_VALUE : (nowMs - thenMs) / 1000;\n}\n\n// Most recent IAP purchase time (unix ms), 0 when the player never purchased. ctx.iap.purchases\n// is LIFETIME history persisted by IAPService (LocalDatabase), oldest -> newest. The grace gate\n// compares this against ctx.sessionStartMs to keep the grace SAME-SESSION only.\nfunction lastPurchaseMs(ctx) {\n  var p = ctx.iap.purchases;\n  return (p && p.length > 0) ? p[p.length - 1].timestampMs : 0;\n}\n\n// segmentUser(ctx) -> 'AdUser' | 'IAPUser' | 'BlendedUser' | 'DefaultUser'\n// Campaign-type segmentation from the acquiring campaign name (ctx.ua.campaign).\n// Case-insensitive CONTAINS checks, first match wins, in this order:\n//   \"iaa\"              -> 'AdUser'       (ad-ROAS campaign)\n//   \"iap\"              -> 'IAPUser'      (IAP-ROAS campaign)\n//   \"blended\"/\"hybrid\" -> 'BlendedUser'\n//   anything else      -> 'DefaultUser'  (incl. organic, no attribution yet, any error)\n// Mirrors two C# twins — keep all three in sync: SegmentationService.Classify (same\n// checks, persisted as CampaignTypes constants) and the ctx.ua feed (campaign is always\n// a string from C#, \"\" before attribution arrives). Still defensive here: no assumptions\n// about ctx.ua's presence, type, or shape — NEVER throws, any failure => 'DefaultUser'.\n// UTILITY ONLY: no baked rule reads the segment today; variants route on it in the entry\n// point (e.g. the _cmp_seg variant disables interstitials for IAPUser).\nfunction segmentUser(ctx) {\n  try {\n    var u = ctx.ua;\n    var raw = (u == null) ? '' : (typeof u === 'string' ? u : u.campaign);\n    var c = (raw == null) ? '' : ('' + raw).toLowerCase();\n    if (c.indexOf('iaa') !== -1) return 'AdUser';\n    if (c.indexOf('iap') !== -1) return 'IAPUser';\n    if (c.indexOf('blended') !== -1 || c.indexOf('hybrid') !== -1) return 'BlendedUser';\n  } catch (e) {}\n  return 'DefaultUser';\n}\n\n\n// =====================================================================================\n// [2] THE DECIDER — fixed, pure rule engine. All thresholds arrive via `params`; it reads\n// nothing else. Evaluates the gates in a fixed order, logs every verdict ([JS] tag), and\n// returns { show, reason } with reason strings matching the C# ad_blocked analytics values.\n// ► Do NOT edit this when tuning — change the PROFILES / entry point below instead.\n//\n// params = {\n//   name: string,                   // optional profile label, printed in every verdict log\n//   enabled: bool,                  // master switch\n//   startLevel: number,             // no interstitials before this level\n//   onWin: bool, onLoss: bool,      // which end-of-level triggers are eligible\n//   minDifficulty: number,          // 0/1/2 — applies to WINS (and losses only if flag below)\n//   difficultyAppliesToLoss: bool,  // false = fail ads show on ANY difficulty\n//   levelInterval: number,          // every Nth qualifying level (1 = every one)\n//   maxPerSession: number,          // 0 = unlimited\n//   minSecondsBetween: number,      // pacing between two interstitials; ALSO seeds the session\n//                                   //   warm-up: the first ad of a session comes no earlier than\n//                                   //   sessionStart + HALF this value\n//   rewardedCooldownSec: number,    // ADDITIVE: each rewarded watched pushes the pending\n//                                   //   interstitial deadline back by this much (see below)\n//   maxSecondsBetween: number,      // ceiling on that stacking, measured from the last\n//                                   //   interstitial (last rewarded's cooldown still always\n//                                   //   honored). Omitted -> 2x minSecondsBetween.\n//   purchaseGraceSec: number,       // POST-PURCHASE GRACE: no interstitials within this many\n//                                   //   seconds after an IAP made in THIS SESSION (an app\n//                                   //   restart clears it). 0/omitted = off. Rationale:\n//                                   //   post-purchase is peak positive sentiment — an ad\n//                                   //   there measurably damages repeat-purchase intent.\n//   window: { maxCount: number, seconds: number }  // rolling-window cap; maxCount 0 = off\n// }\n// =====================================================================================\n\nfunction decideInterstitial(ctx, params) {\n  var sinceInterSec = secondsSince(ctx.nowMs, lastOf(ctx.interstitial.timestampsMs));\n  var sinceRewardedSec = secondsSince(ctx.nowMs, ctx.rewarded.lastShownMs);\n  var sincePurchaseSec = secondsSince(ctx.nowMs, lastPurchaseMs(ctx));\n\n  // Pacing deadline — rewarded cooldown is ADDITIVE, not parallel: start from the normal\n  // gap after the last interstitial, then EVERY rewarded watched pushes the deadline back\n  // by rewardedCooldownSec on top of whatever remained. All anchors are ad END times (the\n  // moment the player got the screen back), so a 30s creative never eats the gap.\n  // Examples (gap 120, rewarded cd 60):\n  //   30s of the gap left, watch a rewarded -> next interstitial 90s after it ENDS (30 + 60)\n  //   90s left -> 150s away; gap already elapsed -> 60s from the rewarded's end.\n  // Watching a rewarded therefore ALWAYS buys extra interstitial-free time.\n  // SESSION WARM-UP: before the FIRST interstitial of a session, half the normal gap must have\n  // elapsed since session start (gap 120 -> first ad no earlier than 60s into the session; scales\n  // with the active profile's minSecondsBetween). After the first ad, normal full-gap pacing.\n  var lastInterMs = lastOf(ctx.interstitial.timestampsMs);\n  var interDeadlineMs = lastInterMs <= 0\n      ? ctx.sessionStartMs + params.minSecondsBetween * 500    // *500 = half the gap, in ms\n      : lastInterMs + params.minSecondsBetween * 1000;\n  var deadlineMs = interDeadlineMs;\n  var lastRewardedSinceInterMs = 0;\n  for (var r = 0; r < ctx.rewarded.timestampsMs.length; r++) {\n    var rewardedMs = ctx.rewarded.timestampsMs[r];\n    if (rewardedMs > lastInterMs) {   // only rewardeds since the last interstitial extend it\n      deadlineMs = Math.max(deadlineMs, rewardedMs) + params.rewardedCooldownSec * 1000;\n      lastRewardedSinceInterMs = rewardedMs;\n    }\n  }\n\n  // Anti-overkill ceiling on the stacking: the deadline never drifts past maxSecondsBetween\n  // after the last interstitial — EXCEPT that the most recent rewarded's full cooldown is\n  // always honored (a rewarded watched near the ceiling still buys its whole quiet period).\n  // Defaults to 2x minSecondsBetween when a pushed variant omits the field. No ceiling\n  // before the first interstitial of the session.\n  if (lastInterMs > 0) {\n    var maxSec = Math.max(params.maxSecondsBetween || params.minSecondsBetween * 2, params.minSecondsBetween);\n    var ceilingMs = lastInterMs + maxSec * 1000;\n    if (deadlineMs > ceilingMs)\n      deadlineMs = Math.max(ceilingMs, lastRewardedSinceInterMs + params.rewardedCooldownSec * 1000);\n  }\n\n  function verdict(show, reason) {\n    log('interstitial decision: ' + (show ? 'SHOW' : 'BLOCK(' + reason + ')') +\n        ' | level=' + ctx.level + ' diff=' + ctx.difficulty +\n        ' won=' + ctx.won + ' failed=' + ctx.failed + ' placement=' + ctx.placement +\n        ' | shownThisSession=' + ctx.interstitial.count +\n        ' sinceInter=' + (sinceInterSec === Number.MAX_VALUE ? 'never' : Math.round(sinceInterSec) + 's') +\n        ' sinceRewarded=' + (sinceRewardedSec === Number.MAX_VALUE ? 'never' : Math.round(sinceRewardedSec) + 's') +\n        ' sincePurchase=' + (sincePurchaseSec === Number.MAX_VALUE ? 'never' : Math.round(sincePurchaseSec) + 's') +\n        ' ready=' + ctx.interstitial.ready +\n        ' | profile=' + (params.name || '?') +\n        ' startLevel=' + params.startLevel + ' minGap=' + params.minSecondsBetween + 's' +\n        ' rewardedCd=' + params.rewardedCooldownSec + 's');\n    return { show: show, reason: reason };\n  }\n  function block(reason) { return verdict(false, reason); }\n\n  if (ctx.adsRemoved)                  return block('ads_removed');\n  if (!params.enabled)                 return block('disabled');\n\n  if (ctx.won && !params.onWin)        return block('wrong_trigger');\n  if (ctx.failed && !params.onLoss)    return block('wrong_trigger');\n\n  // Post-purchase grace: the player just gave us money — do not answer with a fullscreen ad.\n  // SAME-SESSION ONLY (product decision 2026-07): the purchase must have happened in THIS app\n  // session (purchase time >= sessionStartMs) AND within the last purchaseGraceSec. A restart\n  // therefore clears the grace, even if the purchase was minutes ago.\n  if (params.purchaseGraceSec > 0 && lastPurchaseMs(ctx) >= ctx.sessionStartMs &&\n      sincePurchaseSec < params.purchaseGraceSec)\n    return block('purchase_grace');\n\n  if (ctx.level < params.startLevel)   return block('below_start_level');\n\n  var difficultyGated = ctx.won || params.difficultyAppliesToLoss;\n  if (difficultyGated && ctx.difficulty < params.minDifficulty)\n    return block('below_min_difficulty');\n\n  if (ctx.level % Math.max(1, params.levelInterval) !== 0)\n    return block('off_interval');\n\n  if (params.maxPerSession > 0 && ctx.interstitial.count >= params.maxPerSession)\n    return block('session_cap');\n\n  if (ctx.nowMs < deadlineMs)\n    return block(ctx.nowMs < interDeadlineMs ? 'time_cooldown' : 'rewarded_cooldown');\n\n  // Rolling-window cap — \"at most N interstitials in any M-second window\", computed from\n  // the session timestamps. The kind of rule flat values alone can't express.\n  if (params.window && params.window.maxCount > 0 &&\n      countSince(ctx.interstitial.timestampsMs, ctx.nowMs, params.window.seconds) >= params.window.maxCount)\n    return block('window_cap');\n\n  if (!ctx.interstitial.ready)         return block('not_ready');\n\n  return verdict(true, 'ok');\n}\n\n\n// =====================================================================================\n// [3] >>> PRODUCT: EDIT BELOW THIS LINE <<<\n//\n// PROFILES — every threshold, HARDCODED. This is the single place values live; there are\n// no separate remote keys. To ship new values: edit here, publish the whole file as the\n// `interstitial_decision_js_v1` Remote Config string.\n//\n// TWO PROFILES, picked per decision by level bucket only (product decision 2026-07:\n// NO spend-based tier — a spender's only special treatment is the same-session\n// post-purchase grace everyone gets):\n//\n//   EARLY — the level just finished is 1-50.\n//   LATE  — 51 and later.\n//\n// In THIS (baked / Variant A) file the two buckets are IDENTICAL (gap 120s everywhere);\n// the split exists so a remote push can retune one bucket by editing one override\n// literal (e.g. Variant B: LATE gets minSecondsBetween 90). All values are defined ONCE\n// in BASE; each profile is BASE + overrides (makeProfile). Every profile carries a\n// `name`, printed in each [JS] decision log line (profile=...) so QA can see which\n// bucket fired.\n//\n// POST-PURCHASE GRACE (purchaseGraceSec, in BASE): after ANY IAP made in the CURRENT\n// session, no interstitials for 10 min — never answer money with an ad. Session-scoped:\n// an app restart clears it (the decider checks purchase time >= ctx.sessionStartMs).\n// =====================================================================================\n\n// BASE — the shared values (both buckets inherit these).\nvar BASE = {\n  enabled:             true,   // master switch for interstitials\n  startLevel:          20,     // no interstitials before this level\n  onWin:               true,   // show after a level WIN...\n  onLoss:              true,   // ...and after a level FAIL/retry\n  minDifficulty:       1,      // wins only on Hard(1)+ (0=Normal would allow all)\n  difficultyAppliesToLoss: false, // fails show on ANY difficulty\n  levelInterval:       1,      // every Nth qualifying level (1 = every one)\n  maxPerSession:       0,      // max per app session; 0 = unlimited\n  minSecondsBetween:   120,    // seconds between two interstitials\n  rewardedCooldownSec: 60,     // each rewarded watched delays the next interstitial by\n                               // this much ON TOP of any remaining gap (always additive)\n  maxSecondsBetween:   240,    // ceiling on that stacking (2x the gap): the deadline never\n                               // drifts further than this past the last interstitial, but\n                               // the most recent rewarded's cooldown is always honored\n  purchaseGraceSec:    600,    // 10 min ad-free after an IAP made THIS session\n\n  window: {                    // extra safety net: max N interstitials per M seconds\n    maxCount: 0,               // 0 = disabled\n    seconds:  600\n  }\n};\n\n// BASE + any number of override objects (later ones win) -> a complete profile.\nfunction makeProfile() {\n  var p = {};\n  for (var k in BASE) p[k] = BASE[k];\n  for (var i = 0; i < arguments.length; i++)\n    for (var k2 in arguments[i]) p[k2] = arguments[i][k2];\n  return p;\n}\n\nvar LATE_FROM_LEVEL = 51;      // bucket boundary: 1-50 = EARLY, 51+ = LATE\n\nvar EARLY = makeProfile({ name: 'early' });\nvar LATE  = makeProfile({ name: 'late'  });   // identical to EARLY in this variant\n\n// [ENTRY_POINT] MAIN — the C# host calls exactly this function.\n// Strategy: route by level bucket, delegate to the untouched decider. Fancier strategies\n// belong here too (fail-streak pity, A/B arms, eCPM-aware pacing...) — always by editing\n// THIS section and pushing the whole file, never by editing the decider.\nfunction shouldShowInterstitial(ctx) {\n  if (!interstitialAdsEnabled(ctx)) {\n    log('interstitial BLOCK(disabled) — interstitialAdsEnabled=false for this user');\n    return { show: false, reason: 'disabled' };\n  }\n  return decideInterstitial(ctx, ctx.level >= LATE_FROM_LEVEL ? LATE : EARLY);\n}\n\n// [ENTRY_POINT] SECONDARY — should the UI offer rewarded ads at all (show/hide rewarded\n// buttons)? Plain bool, no verdict object. Always-on for now; future variants can gate it\n// (by ctx.level, segment, remote experiment...) by editing this function and re-pushing.\nfunction rewardedAdsEnabled(ctx) {\n  return true;\n}\n\n// [ENTRY_POINT] SECONDARY — are interstitials enabled AT ALL for this user? Plain bool.\n// C# also treats false like a purchased RemoveAds (hides remove-ads offers/bundles via\n// AdsRemovedPermanently), so this must answer the STANDING question \"does this user ever\n// get interstitials\", not a moment-in-time pacing verdict — pacing stays in the profiles.\n// shouldShowInterstitial consults this too (single source of truth: the queryable answer\n// and the actual verdicts can never disagree). Variants gate it per user, e.g. _cmp_seg:\n//   function interstitialAdsEnabled(ctx) { return segmentUser(ctx) !== 'IAPUser'; }\nfunction interstitialAdsEnabled(ctx) {\n  return true;\n}\n\n\n// =====================================================================================\n// HOW TO SPECIALIZE A BUCKET (the intended workflow):\n//   Give the profile its own overrides and publish the whole file, e.g. Variant B\n//   (faster late-game pacing):\n//     var LATE = makeProfile({ name: 'late', minSecondsBetween: 90, maxSecondsBetween: 180 });\n//   Or tune both buckets at once via BASE.\n//\n// Other entry-point-only ideas: pity rule (\"no ad after 3 consecutive fails\" via a js_\n// fail-streak counter), revenue-aware pacing from ctx.interstitial.stats (tighten only\n// when the session is actually paying), difficulty-scaled cooldowns, RC-percentile A/B arms.\n// =====================================================================================\n"
